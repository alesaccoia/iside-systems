# Contact form — set these in Vercel, never in the repository.
# Vercel → Project → Settings → Environment Variables
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
MJ_FROM=            # a sender address verified on Mailjet
MJ_TO=              # where enquiries land; defaults to MJ_FROM
OPENAI_API_KEY=     # server-side only; enables the AI Maturity Check synthesis
OPENAI_MODEL=gpt-4.1-mini
